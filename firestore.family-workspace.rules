// Deploy-ready Firestore rules for existing per-user cloud data and the
// additive encrypted Family Learning Workspace.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isFamilyMember(familyId) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }
    function isActiveFamilyMember(familyId) {
      return isFamilyMember(familyId)
        && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.active == true;
    }

    // Preserve the original rule: every authenticated user can access only
    // their own document and all of its cloud-backup subcollections.
    match /users/{userId} {
      allow read, create, update, delete: if signedIn()
        && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if signedIn()
          && request.auth.uid == userId;
      }
    }

    match /family_invites/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.family_id is string
        && request.resource.data.active == true
        && getAfter(/databases/$(database)/documents/families/$(request.resource.data.family_id)).data.owner_uid == request.auth.uid;
      allow update, delete: if isActiveFamilyMember(resource.data.family_id)
        && get(/databases/$(database)/documents/families/$(resource.data.family_id)/members/$(request.auth.uid)).data.role == 'OWNER_PARENT';
    }

    match /families/{familyId} {
      allow create: if signedIn() && request.resource.data.owner_uid == request.auth.uid;
      allow read: if isActiveFamilyMember(familyId);
      allow update, delete: if isActiveFamilyMember(familyId)
        && resource.data.owner_uid == request.auth.uid;

      match /members/{uid} {
        allow read: if isActiveFamilyMember(familyId);
        allow create: if signedIn() && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.active == true
          && (getAfter(/databases/$(database)/documents/families/$(familyId)).data.owner_uid == request.auth.uid
            || (request.resource.data.invite_code is string
              && get(/databases/$(database)/documents/family_invites/$(request.resource.data.invite_code)).data.family_id == familyId
              && get(/databases/$(database)/documents/family_invites/$(request.resource.data.invite_code)).data.active == true));
        allow update: if signedIn() && (
          get(/databases/$(database)/documents/families/$(familyId)).data.owner_uid == request.auth.uid
          || (uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.role == resource.data.role));
        allow delete: if isActiveFamilyMember(familyId)
          && get(/databases/$(database)/documents/families/$(familyId)).data.owner_uid == request.auth.uid;
      }

      match /shared_snapshots/{snapshotId} {
        allow read, write: if isActiveFamilyMember(familyId);
        match /chunks/{chunkId} {
          allow read, write: if isActiveFamilyMember(familyId);
        }
      }

      match /realtime_records/{recordId} {
        allow read, write: if isActiveFamilyMember(familyId);
        match /payload_chunks/{chunkId} {
          allow read, write: if isActiveFamilyMember(familyId);
        }
      }
    }
  }
}
