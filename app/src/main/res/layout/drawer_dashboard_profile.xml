<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ss_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            app:cardBackgroundColor="@color/ss_blue_soft"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ss_blue_border"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/textDrawerProfileInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-rounded"
                android:gravity="center"
                android:text="S"
                android:textColor="@color/ss_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/textDrawerProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-rounded"
            android:gravity="center"
            android:text="Student Profile"
            android:textColor="@color/ss_text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDrawerProfileDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Active learning profile"
            android:textColor="@color/ss_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDrawerStudentMode"
                style="@style/Widget.StudySaathi.Button.DrawerCompact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="0dp"
                android:layout_weight="1"
                android:text="Student Mode"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:backgroundTint="@color/ss_green_soft"
                app:strokeColor="@color/ss_green_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDrawerParentMode"
                style="@style/Widget.StudySaathi.Button.DrawerCompact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_weight="1"
                android:text="Parent Mode"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:backgroundTint="@color/ss_purple_soft"
                app:strokeColor="@color/ss_purple_border" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/ss_outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDrawerHelp"
            style="@style/Widget.StudySaathi.Button.DrawerCompact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Help, Guide &amp; About"
            android:textAllCaps="false"
            app:backgroundTint="@color/ss_blue_soft"
            app:strokeColor="@color/ss_blue_border" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Profile, goals, reminders, curriculum और backup controls सुरक्षित Parent Mode में उपलब्ध हैं।"
            android:textColor="@color/ss_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
