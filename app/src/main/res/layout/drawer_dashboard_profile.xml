<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ss_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            app:cardBackgroundColor="@color/ss_blue_soft"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ss_blue_border"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/textDrawerProfileInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-rounded"
                android:gravity="center"
                android:text="S"
                android:textColor="@color/ss_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/textDrawerProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-rounded"
            android:gravity="center"
            android:text="Student Profile"
            android:textColor="@color/ss_text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDrawerProfileDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Active learning profile"
            android:textColor="@color/ss_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDrawerStudentMode"
                style="@style/Widget.StudySaathi.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:text="Student Mode"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:backgroundTint="@color/ss_green_soft"
                app:strokeColor="@color/ss_green_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDrawerParentMode"
                style="@style/Widget.StudySaathi.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:text="Parent Mode"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:backgroundTint="@color/ss_purple_soft"
                app:strokeColor="@color/ss_purple_border" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/ss_outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDrawerChangeProfile"
            style="@style/Widget.StudySaathi.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="start|center_vertical"
            android:text="Change Profile"
            android:textAllCaps="false"
            app:backgroundTint="@color/ss_blue_soft"
            app:strokeColor="@color/ss_blue_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDrawerManageProfiles"
            style="@style/Widget.StudySaathi.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="start|center_vertical"
            android:text="Manage Student Profiles"
            android:textAllCaps="false"
            app:backgroundTint="@color/ss_teal_soft"
            app:strokeColor="@color/ss_teal_border" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDrawerDailyStudyGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/ss_green_soft"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ss_green_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Daily Study Goal"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textDrawerDailyStudyGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Set your daily learning target"
                    android:textColor="@color/ss_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="BACKUP &amp; SYNC"
            android:textColor="@color/ss_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDrawerLocalBackup"
            style="@style/Widget.StudySaathi.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="start|center_vertical"
            android:text="Local Backup"
            android:textAllCaps="false"
            app:backgroundTint="@color/ss_yellow_soft"
            app:strokeColor="@color/ss_yellow_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDrawerRestoreImport"
            style="@style/Widget.StudySaathi.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="start|center_vertical"
            android:text="Restore Backup &amp; Import"
            android:textAllCaps="false"
            app:backgroundTint="@color/ss_red_soft"
            app:strokeColor="@color/ss_red_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDrawerCloudSync"
            style="@style/Widget.StudySaathi.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="start|center_vertical"
            android:text="Cloud Account &amp; Sync"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>
