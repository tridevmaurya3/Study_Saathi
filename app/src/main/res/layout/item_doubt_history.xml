<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardDoubtHistory"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="13dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/ss_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/ss_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="13dp"
        android:paddingEnd="11dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textHistorySubject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-rounded"
                android:textColor="@color/ss_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDeleteHistory"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@string/delete_saved_doubt"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:text="✕"
                android:textColor="@color/ss_error"
                android:textSize="17sp"
                app:backgroundTint="@color/ss_red_soft"
                app:cornerRadius="13dp" />

            <TextView
                android:id="@+id/textHistoryArrow"
                android:layout_width="34dp"
                android:layout_height="42dp"
                android:fontFamily="sans-serif-rounded"
                android:gravity="center"
                android:text="›"
                android:textColor="@color/ss_primary"
                android:textSize="29sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/textHistoryChapter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ss_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textHistoryQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-rounded"
            android:maxLines="2"
            android:textColor="@color/ss_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textHistoryAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="@color/ss_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textHistoryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/ss_text_muted"
            android:textSize="11sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>