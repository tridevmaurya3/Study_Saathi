<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/askSaathiRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_soft_mix">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/askSaathiScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/contentAskSaathi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonBack"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="@string/back"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="←"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="28sp"
                    app:cornerRadius="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.StudySaathi.Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ask_study_saathi_title"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/textAskStudent"
                        style="@style/TextAppearance.StudySaathi.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/ask_study_saathi_subtitle"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                app:cardBackgroundColor="@color/ss_purple_soft"
                app:cardCornerRadius="23dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/ss_purple_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        app:cardBackgroundColor="@color/ss_surface"
                        app:cardCornerRadius="19dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/ss_purple_border"
                        app:strokeWidth="1dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="sans-serif-rounded"
                            android:gravity="center"
                            android:text="?"
                            android:textColor="@color/ss_primary_dark"
                            android:textSize="31sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-rounded"
                            android:text="@string/offline_doubt_helper"
                            android:textColor="@color/ss_text_primary"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/offline_doubt_helper_description"
                            android:textColor="@color/ss_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDoubtHistory"
                style="@style/Widget.StudySaathi.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/view_doubt_history"
                android:textAllCaps="false"
                android:textSize="15sp"
                app:backgroundTint="@color/ss_blue_soft"
                app:strokeColor="@color/ss_blue_border" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-rounded"
                android:text="@string/select_learning_context"
                android:textColor="@color/ss_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:hint="@string/select_subject"
                app:boxBackgroundColor="@color/ss_surface"
                app:boxCornerRadiusBottomEnd="17dp"
                app:boxCornerRadiusBottomStart="17dp"
                app:boxCornerRadiusTopEnd="17dp"
                app:boxCornerRadiusTopStart="17dp"
                app:boxStrokeColor="@color/ss_primary">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/dropdownAskSubject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:dropDownHeight="320dp"
                    android:popupElevation="8dp"
                    android:popupBackground="@drawable/bg_professional_dropdown_popup"
                    android:verticalOffset="6dp"
                    android:fontFamily="sans-serif"
                    android:inputType="none"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/select_chapter"
                app:boxBackgroundColor="@color/ss_surface"
                app:boxCornerRadiusBottomEnd="17dp"
                app:boxCornerRadiusBottomStart="17dp"
                app:boxCornerRadiusTopEnd="17dp"
                app:boxCornerRadiusTopStart="17dp"
                app:boxStrokeColor="@color/ss_primary">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/dropdownAskChapter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:dropDownHeight="320dp"
                    android:popupElevation="8dp"
                    android:popupBackground="@drawable/bg_professional_dropdown_popup"
                    android:verticalOffset="6dp"
                    android:fontFamily="sans-serif"
                    android:inputType="none"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-rounded"
                android:text="@string/quick_doubt_help"
                android:textColor="@color/ss_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif"
                android:text="@string/quick_doubt_help_description"
                android:textColor="@color/ss_text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonQuickExplain"
                    style="@style/Widget.StudySaathi.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="58dp"
                    android:text="@string/quick_explain"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:backgroundTint="@color/ss_blue_soft"
                    app:strokeColor="@color/ss_blue_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonQuickKeyPoints"
                    style="@style/Widget.StudySaathi.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minHeight="58dp"
                    android:text="@string/quick_key_points"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:backgroundTint="@color/ss_green_soft"
                    app:strokeColor="@color/ss_green_border" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonQuickExample"
                    style="@style/Widget.StudySaathi.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="58dp"
                    android:text="@string/quick_example"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:backgroundTint="@color/ss_yellow_soft"
                    app:strokeColor="@color/ss_yellow_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonQuickPractice"
                    style="@style/Widget.StudySaathi.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minHeight="58dp"
                    android:text="@string/quick_practice"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:backgroundTint="@color/ss_purple_soft"
                    app:strokeColor="@color/ss_purple_border" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-rounded"
                android:text="@string/ask_your_question"
                android:textColor="@color/ss_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputQuestion"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:hint="@string/question_input_hint"
                app:boxBackgroundColor="@color/ss_surface"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusTopStart="18dp"
                app:boxStrokeColor="@color/ss_primary">

                <com.tridev.studysaathi.ui.widget.StudyQuestionEditText
                    android:id="@+id/editQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:scrollbars="vertical"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonClearQuestion"
                    style="@style/Widget.StudySaathi.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="सवाल साफ करें"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:backgroundTint="@color/ss_surface"
                    app:strokeColor="@color/ss_outline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonToggleQuestionSize"
                    style="@style/Widget.StudySaathi.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="बड़ा करें"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:backgroundTint="@color/ss_purple_soft"
                    app:strokeColor="@color/ss_purple_border" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:text="Question box के अंदर ऊपर-नीचे swipe करके पूरा सवाल पढ़ें। जरूरत होने पर बॉक्स को बड़ा करें।"
                android:textColor="@color/ss_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonQuestionCamera"
                    style="@style/Widget.StudySaathi.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="54dp"
                    android:text="Camera से फोटो लें"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:backgroundTint="@color/ss_blue_soft"
                    app:strokeColor="@color/ss_blue_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonQuestionGallery"
                    style="@style/Widget.StudySaathi.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minHeight="54dp"
                    android:text="Gallery से चुनें"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:backgroundTint="@color/ss_green_soft"
                    app:strokeColor="@color/ss_green_border" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuestionImagePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/ss_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/ss_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-rounded"
                        android:text="Question Photo"
                        android:textColor="@color/ss_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="11dp">

                        <ImageView
                            android:id="@+id/imageQuestionPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:contentDescription="चुनी गई सवाल की फोटो"
                            android:scaleType="centerCrop" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressQuestionImageOcr"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            app:indicatorColor="@color/ss_primary"
                            app:indicatorSize="42dp"
                            app:trackColor="@color/ss_blue_soft"
                            app:trackThickness="4dp" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/textQuestionImageStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="2dp"
                        android:text="फोटो चुनी गई है। App सवाल पढ़कर editable text में दिखाएगी।"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRemoveQuestionImage"
                        style="@style/Widget.StudySaathi.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:text="फोटो हटाएँ"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:backgroundTint="@color/ss_surface"
                        app:strokeColor="@color/ss_outline" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAskSaathi"
                style="@style/Widget.StudySaathi.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/ask_study_saathi_button"
                android:textAllCaps="false"
                android:textSize="16sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/ss_surface"
                app:cardCornerRadius="23dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/ss_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="19dp">

                    <LinearLayout
                        android:id="@+id/layoutConversationHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/labelCurrentQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/your_question"
                        android:textColor="@color/ss_text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textUserQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:fontFamily="sans-serif-rounded"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/ss_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/dividerCurrentTurn"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/ss_divider" />

                    <TextView
                        android:id="@+id/labelCurrentAnswer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/study_saathi_answer"
                        android:textColor="@color/ss_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <com.tridev.studysaathi.ui.widget.StudyMarkdownTextView
                        android:id="@+id/textSaathiAnswer"
                        style="@style/TextAppearance.StudySaathi.Reading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:lineSpacingExtra="4dp"
                        android:textIsSelectable="true" />

                    <LinearLayout
                        android:id="@+id/layoutFollowUpQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-rounded"
                            android:text="@string/ask_saathi_follow_up_title"
                            android:textColor="@color/ss_secondary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputFollowUpQuestion"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:hint="@string/ask_saathi_follow_up_hint"
                            app:boxBackgroundColor="@color/ss_green_soft"
                            app:boxStrokeColor="@color/ss_green_border"
                            app:helperText="@string/ask_saathi_follow_up_helper">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editFollowUpQuestion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top|start"
                                android:imeOptions="actionSend"
                                android:inputType="textCapSentences|textMultiLine"
                                android:maxLength="5000"
                                android:maxLines="5"
                                android:minHeight="92dp"
                                android:paddingTop="13dp"
                                android:paddingBottom="13dp"
                                android:textColor="@color/ss_text_primary"
                                android:textSize="15sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonSendFollowUp"
                            style="@style/Widget.StudySaathi.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="@string/ask_saathi_follow_up_send"
                            android:textAllCaps="false"
                            android:textSize="15sp"
                            app:backgroundTint="@color/ss_secondary" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/textAnswerSpeechStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center_vertical"
                        android:lineSpacingExtra="2dp"
                        android:text="Answer सुनने के लिए नीचे button दबाएँ।"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutAnswerSpeechControls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonSpeakAnswer"
                            style="@style/Widget.StudySaathi.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:minHeight="52dp"
                            android:text="🔊 जवाब सुनें"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            app:backgroundTint="@color/ss_blue_soft"
                            app:strokeColor="@color/ss_blue_border" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonStopAnswerSpeech"
                            style="@style/Widget.StudySaathi.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:minHeight="52dp"
                            android:text="⏹ रोकें"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            android:visibility="gone"
                            app:backgroundTint="@color/ss_yellow_soft"
                            app:strokeColor="@color/ss_yellow_border" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonOpenLesson"
                        style="@style/Widget.StudySaathi.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/open_full_lesson"
                        android:textAllCaps="false"
                        android:textSize="15sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/offline_assistant_note"
                android:textColor="@color/ss_text_muted"
                android:textSize="11sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressAskSaathi"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone"
        app:indicatorColor="@color/ss_primary"
        app:indicatorSize="48dp"
        app:trackColor="@color/ss_blue_soft"
        app:trackThickness="5dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
