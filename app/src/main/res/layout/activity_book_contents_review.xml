<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bookContentsReviewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/backReviewButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Go back"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="‹"
            android:textAllCaps="false"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/reviewScreenTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Review Detected Chapters"
                android:textColor="#152238"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reviewScreenSubtitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Verify every entry before importing."
                android:textColor="#5E6B7A"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/reviewSummaryContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/detectedCandidateSummaryTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 chapter candidates detected"
            android:textColor="#152238"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/parentReviewWarningTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFF4CC"
            android:padding="12dp"
            android:text="OCR results may contain mistakes. Check chapter numbers, titles and page numbers before importing."
            android:textColor="#6B4A00"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/selectAllCandidatesButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Select All"
                android:textAllCaps="false" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/clearCandidateSelectionButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Clear Selection"
                android:textAllCaps="false" />

        </LinearLayout>

        <TextView
            android:id="@+id/reviewErrorTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFF1F0"
            android:padding="12dp"
            android:textColor="#B42318"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chapterCandidatesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:scrollbars="vertical"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/noCandidatesContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No chapters detected"
                android:textColor="#152238"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/noCandidatesMessageTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Try a clearer photo of the book's contents or index page."
                android:textColor="#5E6B7A"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/reviewLoadingContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/reviewLoadingProgressBar"
                style="?android:attr/progressBarStyle"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:id="@+id/reviewLoadingMessageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Preparing chapter candidates…"
                android:textColor="#5E6B7A"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/rawOcrSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/toggleRawOcrTextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Show Raw OCR Text"
            android:textAllCaps="false" />

        <ScrollView
            android:id="@+id/rawOcrTextScrollView"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="6dp"
            android:background="#F5F7FB"
            android:visibility="gone">

            <TextView
                android:id="@+id/rawOcrTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:textColor="#354052"
                android:textIsSelectable="true"
                android:textSize="12sp" />

        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/cancelReviewButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textAllCaps="false" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/importSelectedChaptersButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Import Selected"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>