<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/candidateCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="7dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="7dp"
    app:cardBackgroundColor="@color/ss_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/ss_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/selectCandidateCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:contentDescription="Include this chapter" />

            <TextView
                android:id="@+id/candidateChapterLabelTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Chapter 1"
                android:textColor="@color/ss_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/candidateConfidenceTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/ss_blue_soft"
                android:paddingStart="8dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp"
                android:text="95%"
                android:textColor="@color/ss_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <EditText
            android:id="@+id/candidateChapterNumberEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@android:drawable/edit_text"
            android:hint="Chapter number"
            android:inputType="text"
            android:maxLength="40"
            android:minHeight="48dp"
            android:padding="11dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/candidateChapterTitleEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@android:drawable/edit_text"
            android:hint="Detected chapter title"
            android:inputType="textCapSentences"
            android:maxLength="200"
            android:minHeight="48dp"
            android:padding="11dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/candidateStartPageEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@android:drawable/edit_text"
            android:digits="0123456789"
            android:hint="Start page (optional)"
            android:inputType="number"
            android:maxLength="6"
            android:minHeight="48dp"
            android:padding="11dp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/candidateRawLineTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#F5F7FB"
            android:padding="10dp"
            android:text="OCR: Chapter 1 — Knowing Our Numbers .... 1"
            android:textColor="@color/ss_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/candidateWarningTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Please verify this low-confidence result."
            android:textColor="#B26A00"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>