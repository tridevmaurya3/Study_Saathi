<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chapterNotesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_soft_mix">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentChapterNotes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonBack"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="@string/back"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="←"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="28sp"
                    app:cornerRadius="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.StudySaathi.Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/chapter_notes_title"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/textNotesStudent"
                        style="@style/TextAppearance.StudySaathi.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/chapter_notes_subtitle"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/ss_yellow_soft"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/ss_yellow_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="57dp"
                        android:layout_height="57dp"
                        app:cardBackgroundColor="@color/ss_surface"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/ss_yellow_border"
                        app:strokeWidth="1dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="sans-serif-rounded"
                            android:gravity="center"
                            android:text="N"
                            android:textColor="@color/ss_warning"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-rounded"
                            android:text="@string/chapter_notes_card_title"
                            android:textColor="@color/ss_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/chapter_notes_card_description"
                            android:textColor="@color/ss_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonViewAllNotes"
                style="@style/Widget.StudySaathi.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:enabled="false"
                android:text="@string/chapter_notes_view_all"
                android:textAllCaps="false"
                android:textSize="15sp"
                app:backgroundTint="@color/ss_surface"
                app:strokeColor="@color/ss_yellow_border" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/chapter_notes_subject_label"
                app:boxBackgroundColor="@color/ss_surface"
                app:boxCornerRadiusBottomEnd="17dp"
                app:boxCornerRadiusBottomStart="17dp"
                app:boxCornerRadiusTopEnd="17dp"
                app:boxCornerRadiusTopStart="17dp"
                app:boxStrokeColor="@color/ss_primary">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/dropdownNoteSubject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:dropDownHeight="320dp"
                    android:popupElevation="8dp"
                    android:popupBackground="@drawable/bg_professional_dropdown_popup"
                    android:dropDownVerticalOffset="6dp"
                    android:fontFamily="sans-serif"
                    android:inputType="none"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/chapter_notes_chapter_label"
                app:boxBackgroundColor="@color/ss_surface"
                app:boxCornerRadiusBottomEnd="17dp"
                app:boxCornerRadiusBottomStart="17dp"
                app:boxCornerRadiusTopEnd="17dp"
                app:boxCornerRadiusTopStart="17dp"
                app:boxStrokeColor="@color/ss_primary">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/dropdownNoteChapter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:dropDownHeight="320dp"
                    android:popupElevation="8dp"
                    android:popupBackground="@drawable/bg_professional_dropdown_popup"
                    android:dropDownVerticalOffset="6dp"
                    android:fontFamily="sans-serif"
                    android:inputType="none"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNoteEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/ss_surface"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/ss_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-rounded"
                        android:text="@string/chapter_notes_editor_title"
                        android:textColor="@color/ss_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/chapter_notes_editor_description"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/chapter_notes_hint"
                        app:boxBackgroundColor="@color/ss_background"
                        app:boxCornerRadiusBottomEnd="17dp"
                        app:boxCornerRadiusBottomStart="17dp"
                        app:boxCornerRadiusTopEnd="17dp"
                        app:boxCornerRadiusTopStart="17dp"
                        app:boxStrokeColor="@color/ss_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editChapterNote"
                            android:layout_width="match_parent"
                            android:layout_height="230dp"
                            android:fontFamily="sans-serif"
                            android:gravity="start|top"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLength="3000"
                            android:paddingTop="8dp"
                            android:scrollbars="vertical"
                            android:textColor="@color/ss_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/textNoteCharacterCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:fontFamily="sans-serif"
                        android:gravity="end"
                        android:text="0 / 3000"
                        android:textColor="@color/ss_text_muted"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSaveNote"
                        style="@style/Widget.StudySaathi.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/chapter_notes_save"
                        android:textAllCaps="false"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonClearNote"
                            style="@style/Widget.StudySaathi.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="@string/chapter_notes_clear"
                            android:textAllCaps="false"
                            android:textColor="@color/ss_error"
                            app:backgroundTint="@color/ss_red_soft"
                            app:strokeColor="@color/ss_red_border" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonOpenLesson"
                            style="@style/Widget.StudySaathi.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="@string/chapter_notes_open_lesson"
                            android:textAllCaps="false" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNotesUnavailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/ss_surface"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/ss_outline"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/textNotesUnavailable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:padding="12dp"
                    android:text="@string/chapter_notes_no_chapters"
                    android:textColor="@color/ss_text_secondary"
                    android:textSize="14sp" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressChapterNotes"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone"
        app:indicatorColor="@color/ss_primary"
        app:indicatorSize="48dp"
        app:trackColor="@color/ss_blue_soft"
        app:trackThickness="5dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
