<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardChapter"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/ss_surface"
    app:cardCornerRadius="21dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/ss_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="17dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="58dp"
                android:layout_height="58dp"
                app:cardBackgroundColor="@color/ss_blue_soft"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/ss_blue_border"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/textChapterNumber"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-rounded"
                    android:gravity="center"
                    android:text="01"
                    android:textColor="@color/ss_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textChapterTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-rounded"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textChapterDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/ss_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="7dp"
                android:fontFamily="sans-serif-rounded"
                android:gravity="center"
                android:text="›"
                android:textColor="@color/ss_primary"
                android:textSize="29sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            android:background="@color/ss_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textLessonCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/default_lesson_count"
                android:textColor="@color/ss_text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChapterStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/ss_yellow_soft"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/textChapterStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="@string/chapter_status_start"
                    android:textColor="@color/ss_warning"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressChapter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:max="100"
            android:progress="0"
            app:indicatorColor="@color/ss_primary"
            app:trackColor="@color/ss_surface_muted"
            app:trackCornerRadius="4dp"
            app:trackThickness="7dp" />

        <TextView
            android:id="@+id/textProgressPercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:fontFamily="sans-serif"
            android:gravity="end"
            android:text="@string/default_progress_percent"
            android:textColor="@color/ss_text_muted"
            android:textSize="11sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>