<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/addSchoolSubjectDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/ss_blue_soft"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/ss_blue_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:id="@+id/textSubjectDialogIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="📚"
                android:textSize="24sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textSubjectDialogTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-rounded"
                    android:text="Actual School Subject जोड़ें"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textSubjectDialogDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="केवल वही subject जोड़ें जो बच्चे की current class में school द्वारा पढ़ाया जा रहा है।"
                    android:textColor="@color/ss_text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutSubjectNameEnglish"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Subject Name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputSubjectNameEnglish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="textCapWords"
            android:maxLength="80"
            android:maxLines="2"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutSubjectNameHindi"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Hindi Name (optional)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputSubjectNameHindi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="textCapWords"
            android:maxLength="80"
            android:maxLines="2"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutSubjectCode"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Subject Code (optional)"
        app:helperText="उदाहरण: MATH, SCI, ENG, COMP">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputSubjectCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="textCapCharacters"
            android:maxLength="12"
            android:maxLines="1"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutSubjectCategory"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Subject Category">

        <AutoCompleteTextView
            android:id="@+id/inputSubjectCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                                android:dropDownHeight="320dp"
                                android:popupElevation="8dp"
                                android:popupBackground="@drawable/bg_professional_dropdown_popup"
                                android:dropDownVerticalOffset="6dp"
            android:importantForAutofill="no"
            android:inputType="none"
            android:maxLines="1"
            android:text="Core Academic"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/ss_surface_soft"
        app:cardCornerRadius="17dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/ss_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchSubjectEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="56dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="बच्चे को यह subject दिखाएँ"
                android:textColor="@color/ss_text_primary"
                android:textSize="14sp"
                app:useMaterialThemeColors="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@color/ss_divider" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchSubjectAiTutorEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="56dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="इस subject में AI Tutor चालू रखें"
                android:textColor="@color/ss_text_primary"
                android:textSize="14sp"
                app:useMaterialThemeColors="true" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSubjectDialogInformation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/ss_green_soft"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/ss_green_border"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/textSubjectDialogInformation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:text="Subject save होने के बाद उसकी exact school book scan की जाएगी। Book confirm होने तक कोई default book या chapter बच्चे को नहीं दिखेगा।"
            android:textColor="@color/ss_text_secondary"
            android:textSize="12sp" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/textSubjectDialogError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/ss_error"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>