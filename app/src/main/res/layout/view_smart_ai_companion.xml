<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/smartAiCompanionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/smartAiDismissArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#160B1633"
        android:clickable="true"
        android:contentDescription="@string/smart_companion_close"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/smartAiCompanionPanel"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:gravity="end"
        android:orientation="vertical"
        android:padding="12dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSmartAiCompanion"
            android:layout_width="match_parent"
            android:layout_height="680dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/ss_surface"
            app:cardCornerRadius="26dp"
            app:cardElevation="14dp"
            app:strokeColor="@color/ss_blue_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_app_soft_mix"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/smartAiDragHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/buttonSmartAiMenu"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_companion_menu_button"
                        android:contentDescription="AI menu"
                        android:gravity="center"
                        android:text="☰"
                        android:textColor="@color/ss_primary"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-rounded"
                        android:text="@string/smart_companion_title"
                        android:textColor="@color/ss_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/textSmartAiContext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:textColor="@color/ss_text_secondary"
                    android:textSize="12sp" />

                <!-- Composer stays above the conversation, like a modern AI chat. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutSmartAiQuestion"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/smart_companion_question_hint"
                    app:boxBackgroundColor="@color/ss_surface"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxStrokeColor="@color/ss_primary"
                    app:endIconContentDescription="@string/smart_companion_voice"
                    app:endIconDrawable="@drawable/ic_mic"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editSmartAiQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSend"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLines="3"
                        android:minLines="2"
                        android:textColor="@color/ss_text_primary"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSmartAiPhoto"
                        style="@style/Widget.StudySaathi.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/smart_companion_photo"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:backgroundTint="@color/ss_yellow_soft"
                        app:strokeColor="@color/ss_yellow_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSmartAiSend"
                        style="@style/Widget.StudySaathi.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/smart_companion_send"
                        android:textAllCaps="false"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- All four learning actions remain visible without horizontal scrolling. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSmartAiSimpler"
                        style="@style/Widget.StudySaathi.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="40dp"
                        android:text="@string/smart_companion_simpler"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:backgroundTint="@color/ss_blue_soft"
                        app:strokeColor="@color/ss_blue_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSmartAiExample"
                        style="@style/Widget.StudySaathi.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:minHeight="40dp"
                        android:text="@string/smart_companion_example"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:backgroundTint="@color/ss_green_soft"
                        app:strokeColor="@color/ss_green_border" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSmartAiVisual"
                        style="@style/Widget.StudySaathi.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="40dp"
                        android:text="@string/smart_companion_visual"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:backgroundTint="@color/ss_yellow_soft"
                        app:strokeColor="@color/ss_yellow_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSmartAiQuiz"
                        style="@style/Widget.StudySaathi.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:minHeight="40dp"
                        android:text="@string/smart_companion_quiz"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:backgroundTint="@color/ss_purple_soft"
                        app:strokeColor="@color/ss_purple_border" />

                </LinearLayout>

                <TextView
                    android:id="@+id/textSmartAiStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ss_secondary"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/scrollSmartAiConversation"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="5dp"
                    android:layout_weight="1"
                    android:clipToOutline="true"
                    android:fillViewport="true"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:id="@+id/containerSmartAiConversation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp">

                        <TextView
                            android:id="@+id/textSmartAiWelcome"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/ss_blue_soft"
                            android:gravity="center"
                            android:padding="14dp"
                            android:text="@string/smart_companion_welcome"
                            android:textColor="@color/ss_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                </androidx.core.widget.NestedScrollView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSmartAiNewChat"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:text="@string/smart_companion_new_chat"
                    android:textAllCaps="false"
                    android:textSize="11sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/buttonSmartAiCompanion"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:background="@drawable/bg_smart_ai_companion"
            android:contentDescription="@string/smart_companion_content_description"
            android:elevation="12dp"
            android:fontFamily="sans-serif-rounded"
            android:gravity="center"
            android:text="@string/smart_companion_icon"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
