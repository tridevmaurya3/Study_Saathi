<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/smartAiCompanionRoot"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="end"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSmartAiCompanion"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/ss_surface"
        app:cardCornerRadius="22dp"
        app:cardElevation="10dp"
        app:strokeColor="@color/ss_blue_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-rounded"
                android:text="@string/smart_companion_title"
                android:textColor="@color/ss_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textSmartAiContext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="2"
                android:textColor="@color/ss_text_secondary"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSmartAiSimpler"
                        style="@style/Widget.StudySaathi.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:text="@string/smart_companion_simpler"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:backgroundTint="@color/ss_blue_soft"
                        app:strokeColor="@color/ss_blue_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSmartAiExample"
                        style="@style/Widget.StudySaathi.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:minHeight="40dp"
                        android:text="@string/smart_companion_example"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:backgroundTint="@color/ss_green_soft"
                        app:strokeColor="@color/ss_green_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSmartAiVisual"
                        style="@style/Widget.StudySaathi.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:minHeight="40dp"
                        android:text="@string/smart_companion_visual"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:backgroundTint="@color/ss_yellow_soft"
                        app:strokeColor="@color/ss_yellow_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSmartAiQuiz"
                        style="@style/Widget.StudySaathi.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:minHeight="40dp"
                        android:text="@string/smart_companion_quiz"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:backgroundTint="@color/ss_purple_soft"
                        app:strokeColor="@color/ss_purple_border" />

                </LinearLayout>

            </HorizontalScrollView>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollSmartAiConversation"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@color/ss_surface_soft"
                android:fillViewport="true"
                android:padding="8dp">

                <LinearLayout
                    android:id="@+id/containerSmartAiConversation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textSmartAiWelcome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="18dp"
                        android:text="@string/smart_companion_welcome"
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

            <TextView
                android:id="@+id/textSmartAiStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/ss_secondary"
                android:textSize="11sp"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/smart_companion_question_hint"
                app:boxBackgroundColor="@color/ss_surface"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editSmartAiQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4"
                    android:minLines="2"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSmartAiVoice"
                    style="@style/Widget.StudySaathi.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:text="@string/smart_companion_voice"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:backgroundTint="@color/ss_green_soft"
                    app:strokeColor="@color/ss_green_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSmartAiPhoto"
                    style="@style/Widget.StudySaathi.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:text="@string/smart_companion_photo"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:backgroundTint="@color/ss_yellow_soft"
                    app:strokeColor="@color/ss_yellow_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSmartAiSend"
                    style="@style/Widget.StudySaathi.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:text="@string/smart_companion_send"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSmartAiNewChat"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="34dp"
                android:text="@string/smart_companion_new_chat"
                android:textAllCaps="false"
                android:textSize="11sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/buttonSmartAiCompanion"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:background="@drawable/bg_smart_ai_companion"
        android:contentDescription="@string/smart_companion_content_description"
        android:elevation="12dp"
        android:fontFamily="sans-serif-rounded"
        android:gravity="center"
        android:text="@string/smart_companion_icon"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
