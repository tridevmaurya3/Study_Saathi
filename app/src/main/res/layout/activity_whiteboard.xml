<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_app_soft_mix" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonBack"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp"
            android:layout_height="48dp" android:minWidth="0dp" android:text="←" android:textSize="26sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Interactive Whiteboard" android:textColor="@color/ss_text_primary"
                android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/textWhiteboardMode" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Pen mode • लिखना शुरू करें"
                android:textColor="@color/ss_text_secondary" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonPen"
            style="@style/Widget.StudySaathi.Button.Outlined" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="0dp" android:text="Pen" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonEraser"
            style="@style/Widget.StudySaathi.Button.Outlined" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:minWidth="0dp" android:text="Eraser" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonUndo"
            style="@style/Widget.StudySaathi.Button.Outlined" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:minWidth="0dp" android:text="Undo" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonClear"
            style="@style/Widget.StudySaathi.Button.Outlined" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:minWidth="0dp" android:text="Clear" android:textAllCaps="false" />
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_marginTop="10dp" android:layout_weight="1"
        app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/ss_blue_border" app:strokeWidth="1dp">
        <com.tridev.studysaathi.view.StudyWhiteboardView android:id="@+id/studyWhiteboard"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:contentDescription="Touch drawing whiteboard" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
