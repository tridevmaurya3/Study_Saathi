<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_app_soft_mix" android:orientation="vertical" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonBack"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp"
            android:layout_height="42dp" android:minWidth="0dp" android:text="←" android:textSize="24sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Interactive Whiteboard" android:textColor="@color/ss_text_primary"
                android:textSize="19sp" android:textStyle="bold" />
            <TextView android:id="@+id/textWhiteboardMode" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Pen mode • लिखना शुरू करें"
                android:textColor="@color/ss_text_secondary" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp"
        android:layout_marginTop="4dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonPen"
            style="@style/Widget.StudySaathi.Button.Outlined" android:layout_width="0dp"
            android:layout_height="40dp" android:layout_weight="1" android:minWidth="0dp" android:text="" android:contentDescription="Pen" android:tooltipText="Pen" app:cornerRadius="14dp" app:icon="@drawable/ic_whiteboard_pen" app:iconGravity="textStart" app:iconSize="21dp" app:iconTint="@color/ss_primary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonEraser"
            style="@style/Widget.StudySaathi.Button.Outlined" android:layout_width="0dp"
            android:layout_height="40dp" android:layout_marginStart="3dp" android:layout_weight="1" android:minWidth="0dp" android:text="" android:contentDescription="Eraser" android:tooltipText="Eraser" app:cornerRadius="14dp" app:icon="@drawable/ic_whiteboard_eraser" app:iconGravity="textStart" app:iconSize="21dp" app:iconTint="@color/ss_primary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonUndo"
            style="@style/Widget.StudySaathi.Button.Outlined" android:layout_width="0dp"
            android:layout_height="40dp" android:layout_marginStart="3dp" android:layout_weight="1" android:minWidth="0dp" android:text="" android:contentDescription="Undo" android:tooltipText="Undo" app:cornerRadius="14dp" app:icon="@drawable/ic_whiteboard_undo" app:iconGravity="textStart" app:iconSize="21dp" app:iconTint="@color/ss_primary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonClear"
            style="@style/Widget.StudySaathi.Button.Outlined" android:layout_width="0dp"
            android:layout_height="40dp" android:layout_marginStart="3dp" android:layout_weight="1" android:minWidth="0dp" android:text="" android:contentDescription="Clear" android:tooltipText="Clear" app:cornerRadius="14dp" app:icon="@drawable/ic_whiteboard_clear" app:iconGravity="textStart" app:iconSize="20dp" app:iconTint="@color/ss_primary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonRecognize"
            style="@style/Widget.StudySaathi.Button.Outlined" android:layout_width="0dp"
            android:layout_height="40dp" android:layout_marginStart="3dp" android:layout_weight="1" android:minWidth="0dp"
            android:text="" android:contentDescription="Recognize handwriting" android:tooltipText="Recognize"
            app:backgroundTint="@color/ss_blue_soft" app:cornerRadius="14dp" app:icon="@drawable/ic_whiteboard_recognize" app:iconGravity="textStart" app:iconSize="21dp" app:iconTint="@color/ss_primary" app:strokeColor="@color/ss_blue_border" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonSolve"
            style="@style/Widget.StudySaathi.Button.Primary" android:layout_width="0dp"
            android:layout_height="40dp" android:layout_marginStart="3dp" android:layout_weight="1"
            android:minWidth="0dp" android:text="" android:contentDescription="Solve with Study Saathi AI" android:tooltipText="Solve with AI" app:cornerRadius="14dp" app:icon="@drawable/ic_whiteboard_spark" app:iconGravity="textStart" app:iconSize="21dp" app:iconTint="@color/white" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_marginTop="5dp" android:layout_weight="1"
        app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/ss_blue_border" app:strokeWidth="1dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <com.tridev.studysaathi.view.StudyWhiteboardView android:id="@+id/studyWhiteboard"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:contentDescription="Touch drawing whiteboard" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="start|top" android:layout_margin="10dp"
                android:background="@drawable/bg_whiteboard_status_chip" android:gravity="center_vertical"
                android:orientation="horizontal" android:paddingStart="10dp" android:paddingTop="6dp"
                android:paddingEnd="10dp" android:paddingBottom="6dp">
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressWhiteboardRecognition" android:layout_width="20dp"
                    android:layout_height="20dp" android:visibility="gone" app:indicatorSize="20dp"
                    app:trackThickness="2dp" />
                <TextView android:id="@+id/textRecognitionStatus" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="5dp"
                    android:maxWidth="260dp" android:text="लिखें • Auto recognition चालू"
                    android:textColor="@color/ss_text_secondary" android:textSize="10sp" />
            </LinearLayout>
            <TextView android:id="@+id/textWhiteboardCanvasAnswer"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end|bottom" android:layout_margin="12dp"
                android:background="@drawable/bg_whiteboard_smart_answer"
                android:elevation="6dp" android:maxWidth="300dp" android:paddingStart="14dp"
                android:paddingTop="9dp" android:paddingEnd="14dp" android:paddingBottom="9dp"
                android:textColor="#135F46" android:textSize="16sp" android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
