<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bookContentsScanScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backFromContentsScanButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Go back"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="‹"
                android:textAllCaps="false"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/contentsScanTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Scan Contents Page"
                    android:textColor="#152238"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/contentsScanBookTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Exact School Book"
                    android:textColor="#5E6B7A"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#EAF0FF"
            android:padding="14dp"
            android:text="Open the book's Contents or Index page. Use a clear, straight photo with all chapter names and page numbers visible."
            android:textColor="#25427D"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/takeContentsPhotoButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="Take Photo"
                android:textAllCaps="false" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/chooseContentsGalleryButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="Choose Gallery"
                android:textAllCaps="false" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="14dp"
            android:background="#E2E7EF">

            <ImageView
                android:id="@+id/contentsImagePreviewImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="Selected contents page"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/noContentsImageContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄"
                    android:textSize="54sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="No contents-page image selected"
                    android:textColor="#354052"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Take a photo or choose an existing image."
                    android:textColor="#6A7585"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/contentsOcrProgressContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#CCFFFFFF"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/contentsOcrProgressBar"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="52dp"
                    android:layout_height="52dp" />

                <TextView
                    android:id="@+id/contentsOcrProgressTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Reading contents page…"
                    android:textColor="#354052"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/selectedContentsImageTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="middle"
            android:maxLines="2"
            android:textColor="#5E6B7A"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/contentsScanErrorTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#FFF1F0"
            android:padding="12dp"
            android:textColor="#B42318"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/startContentsOcrButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:enabled="false"
            android:text="Read Chapters from Image"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/reviewDetectedChaptersButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="Review Detected Chapters"
            android:textAllCaps="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/contentsScanResultSummaryTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#E8F5E9"
            android:padding="12dp"
            android:textColor="#207A3C"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Photo tips"
            android:textColor="#152238"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="• Keep the page flat and fully visible.&#10;• Avoid shadows, glare and tilted photos.&#10;• Use one Contents/Index page at a time.&#10;• Ensure chapter titles and page numbers are readable.&#10;• Every detected chapter will require Parent review."
            android:textColor="#536174"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>