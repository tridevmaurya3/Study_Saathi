<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ss_surface" android:elevation="20dp" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@color/ss_blue_soft" android:orientation="vertical"
            android:paddingStart="20dp" android:paddingTop="30dp"
            android:paddingEnd="18dp" android:paddingBottom="21dp">
            <TextView android:layout_width="56dp" android:layout_height="56dp"
                android:background="@drawable/bg_help_step_badge" android:gravity="center"
                android:text="S" android:textColor="@color/ss_on_primary"
                android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="13dp" android:fontFamily="sans-serif-rounded"
                android:text="Student Learning Center" android:textColor="@color/ss_text_primary"
                android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Learn • Practise • Revise • Grow"
                android:textColor="@color/ss_text_secondary" android:textSize="13sp" />
        </LinearLayout>

        <TextView style="@style/TextAppearance.StudySaathi.Body" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="20dp"
            android:layout_marginTop="16dp" android:text="LEARN"
            android:textColor="@color/ss_text_muted" android:textSize="11sp" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonMenuDashboard"
            style="@style/Widget.StudySaathi.Button.Outlined" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="16dp"
            android:layout_marginTop="5dp" android:layout_marginEnd="16dp"
            android:gravity="start|center_vertical" android:text="⌂   Dashboard Home"
            android:textAllCaps="false" app:backgroundTint="@color/ss_blue_soft" app:strokeColor="@color/ss_blue_border" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonMenuSubjects"
            style="@style/Widget.StudySaathi.Button.Outlined" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="16dp"
            android:layout_marginTop="4dp" android:layout_marginEnd="16dp"
            android:gravity="start|center_vertical" android:text="▣   Subjects &amp; Curriculum"
            android:textAllCaps="false" app:backgroundTint="@color/ss_green_soft" app:strokeColor="@color/ss_green_border" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonMenuAskSaathi"
            style="@style/Widget.StudySaathi.Button.Outlined" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="16dp"
            android:layout_marginTop="4dp" android:layout_marginEnd="16dp"
            android:gravity="start|center_vertical" android:text="◆   Ask Study Saathi AI"
            android:textAllCaps="false" app:backgroundTint="@color/ss_purple_soft" app:strokeColor="@color/ss_purple_border" />

        <TextView style="@style/TextAppearance.StudySaathi.Body" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="20dp"
            android:layout_marginTop="16dp" android:text="PLAN &amp; REVISE"
            android:textColor="@color/ss_text_muted" android:textSize="11sp" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonMenuSmartStudyPlan"
            style="@style/Widget.StudySaathi.Button.Outlined" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="16dp"
            android:layout_marginTop="5dp" android:layout_marginEnd="16dp"
            android:gravity="start|center_vertical" android:text="✦   Smart Study Plan"
            android:textAllCaps="false" app:backgroundTint="@color/ss_purple_soft" app:strokeColor="@color/ss_purple_border" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonMenuRevision"
            style="@style/Widget.StudySaathi.Button.Outlined" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="16dp"
            android:layout_marginTop="4dp" android:layout_marginEnd="16dp"
            android:gravity="start|center_vertical" android:text="↻   Revision Planner"
            android:textAllCaps="false" app:backgroundTint="@color/ss_yellow_soft" app:strokeColor="@color/ss_yellow_border" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonMenuChapterNotes"
            style="@style/Widget.StudySaathi.Button.Outlined" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="16dp"
            android:layout_marginTop="4dp" android:layout_marginEnd="16dp"
            android:gravity="start|center_vertical" android:text="✎   Chapter Notes"
            android:textAllCaps="false" app:backgroundTint="@color/ss_green_soft" app:strokeColor="@color/ss_green_border" />

        <TextView style="@style/TextAppearance.StudySaathi.Body" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="20dp"
            android:layout_marginTop="16dp" android:text="PROGRESS"
            android:textColor="@color/ss_text_muted" android:textSize="11sp" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonMenuWeeklyStudy"
            style="@style/Widget.StudySaathi.Button.Outlined" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="16dp"
            android:layout_marginTop="5dp" android:layout_marginEnd="16dp"
            android:gravity="start|center_vertical" android:text="◷   Weekly Study"
            android:textAllCaps="false" app:backgroundTint="@color/ss_teal_soft" app:strokeColor="@color/ss_teal_border" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonMenuLearningProgress"
            style="@style/Widget.StudySaathi.Button.Outlined" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="16dp"
            android:layout_marginTop="4dp" android:layout_marginEnd="16dp"
            android:gravity="start|center_vertical" android:text="✓   Learning Progress"
            android:textAllCaps="false" app:backgroundTint="@color/ss_blue_soft" app:strokeColor="@color/ss_blue_border" />

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="16dp"
            android:layout_marginTop="14dp" android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/ss_blue_soft" app:cardCornerRadius="20dp"
            app:cardElevation="0dp" app:strokeColor="@color/ss_blue_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:text="समझो • Practise • आगे बढ़ो"
                    android:textColor="@color/ss_primary" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/textMenuAppVersion" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:gravity="center" android:text="Study Saathi • Version 1.0"
                    android:textColor="@color/ss_text_secondary" android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
