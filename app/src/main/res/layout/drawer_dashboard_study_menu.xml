<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ss_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-rounded"
            android:text="Study Saathi"
            android:textColor="@color/ss_primary"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Learning &amp; Study Menu"
            android:textColor="@color/ss_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/ss_blue_soft"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ss_blue_border"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Everything needed for focused daily learning—kept separate from profile and backup controls."
                android:textColor="@color/ss_text_secondary"
                android:textSize="13sp" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMenuDashboard"
            style="@style/Widget.StudySaathi.Button.DrawerCompact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="start|center_vertical"
            android:text="Dashboard Home"
            android:textAllCaps="false"
            app:backgroundTint="@color/ss_blue_soft"
            app:strokeColor="@color/ss_blue_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMenuSubjects"
            style="@style/Widget.StudySaathi.Button.DrawerCompact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="start|center_vertical"
            android:text="Subjects &amp; Curriculum"
            android:textAllCaps="false"
            app:backgroundTint="@color/ss_green_soft"
            app:strokeColor="@color/ss_green_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMenuSmartStudyPlan"
            style="@style/Widget.StudySaathi.Button.DrawerCompact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="start|center_vertical"
            android:text="Smart Study Plan"
            android:textAllCaps="false"
            app:backgroundTint="@color/ss_purple_soft"
            app:strokeColor="@color/ss_purple_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMenuRevision"
            style="@style/Widget.StudySaathi.Button.DrawerCompact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="start|center_vertical"
            android:text="Revision Planner"
            android:textAllCaps="false"
            app:backgroundTint="@color/ss_yellow_soft"
            app:strokeColor="@color/ss_yellow_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMenuWeeklyStudy"
            style="@style/Widget.StudySaathi.Button.DrawerCompact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="start|center_vertical"
            android:text="Weekly Study"
            android:textAllCaps="false"
            app:backgroundTint="@color/ss_teal_soft"
            app:strokeColor="@color/ss_teal_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMenuLearningProgress"
            style="@style/Widget.StudySaathi.Button.DrawerCompact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="start|center_vertical"
            android:text="Learning Progress"
            android:textAllCaps="false"
            app:backgroundTint="@color/ss_blue_soft"
            app:strokeColor="@color/ss_blue_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMenuAskSaathi"
            style="@style/Widget.StudySaathi.Button.DrawerCompact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="start|center_vertical"
            android:text="Ask Study Saathi"
            android:textAllCaps="false"
            app:backgroundTint="@color/ss_purple_soft"
            app:strokeColor="@color/ss_purple_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMenuChapterNotes"
            style="@style/Widget.StudySaathi.Button.DrawerCompact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="start|center_vertical"
            android:text="Chapter Notes"
            android:textAllCaps="false"
            app:backgroundTint="@color/ss_green_soft"
            app:strokeColor="@color/ss_green_border" />

    </LinearLayout>

</ScrollView>
