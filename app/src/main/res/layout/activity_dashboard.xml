<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_soft_mix">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/dashboardContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_app_soft_mix">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/dashboardScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/contentDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="0dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <!-- App header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:background="@color/ss_background"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:elevation="6dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardDashboardMenu"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:contentDescription="Open study menu"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/ss_surface"
                        app:cardCornerRadius="15dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/ss_outline"
                        app:strokeWidth="1dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="☰"
                            android:textColor="@color/ss_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-rounded"
                            android:text="@string/app_name"
                            android:textColor="@color/ss_text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/dashboard_subtitle"
                            android:textColor="@color/ss_text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardStudentHelp"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:contentDescription="Student mode help"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/ss_surface"
                        app:cardCornerRadius="15dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/ss_outline"
                        app:strokeWidth="1dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="?"
                            android:textColor="@color/ss_primary"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardProfileShortcut"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:clickable="true"
                        android:contentDescription="@string/manage_student_profiles"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/ss_surface"
                        app:cardCornerRadius="15dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/ss_outline"
                        app:strokeWidth="1dp">

                        <TextView
                            android:id="@+id/textProfileInitial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="sans-serif-rounded"
                            android:gravity="center"
                            android:text="S"
                            android:textColor="@color/ss_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Student welcome and continue card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/ss_blue_soft"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/ss_blue_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.06"
                            android:text="@string/my_learning_dashboard"
                            android:textAllCaps="true"
                            android:textColor="@color/ss_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textGreeting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-rounded"
                            android:text="@string/dashboard_default_greeting"
                            android:textColor="@color/ss_text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textStudentDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/loading_student_profile"
                            android:textColor="@color/ss_text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/textStudentSchoolDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="School details pending"
                            android:textColor="@color/ss_secondary"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/textExplanationLanguage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/loading_explanation_language"
                            android:textColor="@color/ss_text_muted"
                            android:textSize="13sp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            app:cardBackgroundColor="@color/ss_surface"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/ss_blue_border"
                            app:strokeWidth="1dp">

                            <TextView
                                android:id="@+id/textContinueLearningDetail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:lineSpacingExtra="2dp"
                                android:padding="13dp"
                                android:text="@string/continue_learning_default_detail"
                                android:textColor="@color/ss_text_secondary"
                                android:textSize="13sp" />

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonContinueLearning"
                            style="@style/Widget.StudySaathi.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/start_learning"
                            android:textAllCaps="false"
                            android:textSize="16sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Today summary -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-rounded"
                    android:text="@string/today_learning"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/today_learning_description"
                    android:textColor="@color/ss_text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- Completed lesson summary -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="150dp"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/ss_green_soft"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/ss_green_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/textCompletedLessonsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-rounded"
                                android:text="0"
                                android:textColor="@color/ss_success"
                                android:textSize="30sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="sans-serif-rounded"
                                android:text="@string/lessons_done"
                                android:textColor="@color/ss_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textCompletedLessonsDetail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="sans-serif"
                                android:lineSpacingExtra="1dp"
                                android:text="@string/lessons_done_empty_detail"
                                android:textColor="@color/ss_text_secondary"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Streak summary -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="150dp"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/ss_yellow_soft"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/ss_yellow_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/textStreakValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-rounded"
                                android:text="0"
                                android:textColor="@color/ss_warning"
                                android:textSize="30sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="sans-serif-rounded"
                                android:text="@string/learning_streak"
                                android:textColor="@color/ss_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textStreakDetail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="sans-serif"
                                android:lineSpacingExtra="1dp"
                                android:text="@string/streak_empty_detail"
                                android:textColor="@color/ss_text_secondary"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Study coach -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-rounded"
                    android:text="@string/smart_study_coach"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/smart_study_coach_description"
                    android:textColor="@color/ss_text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStudyCoach"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="false"
                    android:focusable="false"
                    app:cardBackgroundColor="@color/ss_purple_soft"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/ss_purple_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            app:cardBackgroundColor="@color/ss_surface"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/ss_purple_border"
                            app:strokeWidth="1dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="sans-serif-rounded"
                                android:gravity="center"
                                android:text="★"
                                android:textColor="#74439A"
                                android:textSize="27sp"
                                android:textStyle="bold" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textCoachMessage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-rounded"
                                android:lineSpacingExtra="2dp"
                                android:text="@string/default_coach_message"
                                android:textColor="@color/ss_text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:fontFamily="sans-serif"
                                android:text="Your personalised learning guidance"
                                android:textColor="@color/ss_text_secondary"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSmartStudyPlan"
                        style="@style/Widget.StudySaathi.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:text="Smart Study Plan"
                        android:textAllCaps="false"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonStudyTools"
                        style="@style/Widget.StudySaathi.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:text="Study Tools"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        app:backgroundTint="@color/ss_yellow_soft"
                        app:strokeColor="@color/ss_yellow_border" />

                </LinearLayout>

                <!-- Quick actions -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-rounded"
                    android:text="@string/quick_learning_actions"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/quick_learning_actions_description"
                    android:textColor="@color/ss_text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSubjects"
                        style="@style/Widget.StudySaathi.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:text="@string/subjects"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        app:backgroundTint="@color/ss_blue_soft"
                        app:strokeColor="@color/ss_blue_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRevision"
                        style="@style/Widget.StudySaathi.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:text="@string/revision"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        app:backgroundTint="@color/ss_green_soft"
                        app:strokeColor="@color/ss_green_border" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonAskSaathi"
                    style="@style/Widget.StudySaathi.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ask_study_saathi"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    app:backgroundTint="@color/ss_purple_soft"
                    app:strokeColor="@color/ss_purple_border" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/ss_surface"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/ss_blue_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-rounded"
                            android:text="Advanced Quick Tools"
                            android:textColor="@color/ss_text_primary"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="सभी smart study tools एक ही जगह—जिसे चाहें एक tap में खोलें।"
                            android:textColor="@color/ss_text_secondary"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonQuickRevision"
                                style="@style/Widget.StudySaathi.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="↻ Revision"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                app:backgroundTint="@color/ss_yellow_soft"
                                app:cornerRadius="16dp"
                                app:strokeColor="@color/ss_yellow_border" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonQuickMockExam"
                                style="@style/Widget.StudySaathi.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_marginStart="5dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="◷ Mock Exam"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                app:backgroundTint="@color/ss_red_soft"
                                app:cornerRadius="16dp"
                                app:strokeColor="@color/ss_red_border" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonQuickFlashcards"
                                style="@style/Widget.StudySaathi.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="▤ Flashcards"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                app:backgroundTint="@color/ss_blue_soft"
                                app:cornerRadius="16dp"
                                app:strokeColor="@color/ss_blue_border" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonQuickMistakes"
                                style="@style/Widget.StudySaathi.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_marginStart="5dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="! Mistakes"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                app:backgroundTint="@color/ss_red_soft"
                                app:cornerRadius="16dp"
                                app:strokeColor="@color/ss_red_border" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonQuickWhiteboard"
                                style="@style/Widget.StudySaathi.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="✎ Whiteboard"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                app:backgroundTint="@color/ss_green_soft"
                                app:cornerRadius="16dp"
                                app:strokeColor="@color/ss_green_border" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonQuickReminders"
                                style="@style/Widget.StudySaathi.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_marginStart="5dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="◷ Reminders"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                app:backgroundTint="@color/ss_yellow_soft"
                                app:cornerRadius="16dp"
                                app:strokeColor="@color/ss_yellow_border" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonQuickOffline"
                                style="@style/Widget.StudySaathi.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="⇩ Offline"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                app:backgroundTint="@color/ss_teal_soft"
                                app:cornerRadius="16dp"
                                app:strokeColor="@color/ss_teal_border" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonQuickTour"
                                style="@style/Widget.StudySaathi.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_marginStart="5dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="ⓘ App Tour"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                app:backgroundTint="@color/ss_purple_soft"
                                app:cornerRadius="16dp"
                                app:strokeColor="@color/ss_purple_border" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonQuickAchievements"
                                style="@style/Widget.StudySaathi.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="★ Rewards"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                app:backgroundTint="@color/ss_blue_soft"
                                app:cornerRadius="16dp"
                                app:strokeColor="@color/ss_blue_border" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonQuickParentReport"
                                style="@style/Widget.StudySaathi.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_marginStart="5dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="▥ Parent Report"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                app:backgroundTint="@color/ss_green_soft"
                                app:cornerRadius="16dp"
                                app:strokeColor="@color/ss_green_border" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/dashboard_parent_note"
                    android:textColor="@color/ss_text_muted"
                    android:textSize="12sp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressDashboard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone"
            app:indicatorColor="@color/ss_primary"
            app:indicatorSize="48dp"
            app:trackColor="@color/ss_blue_soft"
            app:trackThickness="5dp" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <include
        android:id="@+id/studyMenuDrawerPanel"
        layout="@layout/drawer_dashboard_study_menu"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

    <include
        android:id="@+id/profileDrawerPanel"
        layout="@layout/drawer_dashboard_profile"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end" />

</androidx.drawerlayout.widget.DrawerLayout>
