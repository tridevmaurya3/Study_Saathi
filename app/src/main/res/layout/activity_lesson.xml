<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lessonScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_soft_mix"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="38dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBack"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/back"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:text="←"
                android:textColor="@color/ss_text_primary"
                android:textSize="28sp"
                app:cornerRadius="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.StudySaathi.Heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_lesson"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/textLessonCurriculum"
                    style="@style/TextAppearance.StudySaathi.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Curriculum • Class • Subject"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/ss_blue_soft"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ss_blue_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.07"
                    android:text="@string/current_chapter"
                    android:textAllCaps="true"
                    android:textColor="@color/ss_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textLessonChapterTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:fontFamily="sans-serif-rounded"
                    android:text="Chapter"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textLessonTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:fontFamily="sans-serif"
                    android:text="Lesson title"
                    android:textColor="@color/ss_text_secondary"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonBookmarkChapter"
                    style="@style/Widget.StudySaathi.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:enabled="false"
                    android:text="@string/lesson_bookmark_loading"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:backgroundTint="@color/ss_surface"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/ss_blue_border"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:fontFamily="sans-serif-rounded"
            android:text="@string/reading_preferences"
            android:textColor="@color/ss_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            app:cardBackgroundColor="@color/ss_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ss_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/reading_font_size"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonDecreaseFont"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:contentDescription="@string/decrease_reading_font"
                    android:text=""
                    android:textAllCaps="false"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_font_decrease"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="24dp"
                    app:strokeColor="@color/ss_outline" />

                <TextView
                    android:id="@+id/textFontSize"
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="18sp"
                    android:textColor="@color/ss_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonIncreaseFont"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:contentDescription="@string/increase_reading_font"
                    android:text=""
                    android:textAllCaps="false"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_font_increase"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="24dp"
                    app:strokeColor="@color/ss_outline" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleLessonLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            app:checkedButton="@id/buttonBilingual"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBilingual"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="@string/bilingual"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonHindi"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="@string/hindi"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEnglish"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="@string/english"
                android:textAllCaps="false"
                android:textSize="12sp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:fontFamily="sans-serif-rounded"
            android:text="@string/easy_explanation"
            android:textColor="@color/ss_text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/ss_surface"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ss_outline"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/textExplanation"
                style="@style/TextAppearance.StudySaathi.Reading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="19dp"
                android:textIsSelectable="true" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/textKeyPointsHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:fontFamily="sans-serif-rounded"
            android:text="@string/key_points"
            android:textColor="@color/ss_text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardKeyPoints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/ss_green_soft"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ss_green_border"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/textKeyPoints"
                style="@style/TextAppearance.StudySaathi.Reading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="19dp"
                android:textIsSelectable="true" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/textExampleHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:fontFamily="sans-serif-rounded"
            android:text="@string/simple_example"
            android:textColor="@color/ss_text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardExample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/ss_yellow_soft"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ss_yellow_border"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/textExample"
                style="@style/TextAppearance.StudySaathi.Reading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="19dp"
                android:textIsSelectable="true" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/textPracticeHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:fontFamily="sans-serif-rounded"
            android:text="@string/try_yourself"
            android:textColor="@color/ss_text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPracticeQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/ss_purple_soft"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ss_purple_border"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/textPracticeQuestion"
                style="@style/TextAppearance.StudySaathi.Reading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="19dp"
                android:textIsSelectable="true" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPractice"
            style="@style/Widget.StudySaathi.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/check_understanding"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/ss_teal_soft"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ss_teal_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:fontFamily="sans-serif-rounded"
                    android:gravity="center"
                    android:text="★"
                    android:textColor="@color/ss_secondary"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-rounded"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/lesson_encouragement"
                    android:textColor="@color/ss_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCompleteLesson"
            style="@style/Widget.StudySaathi.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/mark_lesson_complete"
            android:textAllCaps="false"
            android:textSize="16sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
