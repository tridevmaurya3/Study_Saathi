<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">

        <shape android:shape="rectangle">

            <solid android:color="@color/ss_blue_soft" />

            <stroke
                android:width="2dp"
                android:color="@color/ss_primary" />

            <corners android:radius="17dp" />

        </shape>

    </item>

    <item>

        <shape android:shape="rectangle">

            <solid android:color="@color/ss_surface" />

            <stroke
                android:width="1dp"
                android:color="@color/ss_outline" />

            <corners android:radius="17dp" />

        </shape>

    </item>

</selector>