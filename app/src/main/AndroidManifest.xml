<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission
        android:name="android.permission.INTERNET" />

    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".StudySaathiApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudySaathi"
        android:usesCleartextTraffic="false">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/book_cover_file_paths" />

        </provider>

        <receiver
            android:name=".reminder.StudyReminderActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Camera/Gallery à¤¸à¥‡ Contents page à¤²à¥‡à¤•à¤° OCR à¤šà¤²à¤¾à¤¨à¥‡ à¤•à¥€ screen. -->
        <activity
            android:name=".BookContentsScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- OCR candidates à¤•à¥€ Parent review screen. -->
        <activity
            android:name=".BookContentsReviewActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Parent full-book PDF/image learning-content import screen. -->
        <activity
            android:name=".BookLearningImportActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Parent review/edit screen for automatically detected chapter boundaries. -->
        <activity
            android:name=".BookChapterBoundaryReviewActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Exact school-book chapter list à¤”à¤° management. -->
        <activity
            android:name=".SchoolBookChaptersActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Manual chapter Add/Edit screen. -->
        <activity
            android:name=".ManualSchoolBookChapterActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Manual exact school-book entry screen. -->
        <activity
            android:name=".ManualSchoolBookActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Parent school-curriculum setup screen. -->
        <activity
            android:name=".SchoolCurriculumSetupActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Scanned book details à¤•à¥€ Parent review screen. -->
        <activity
            android:name=".BookMatchReviewActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- School-book cover scan à¤”à¤° online discovery screen. -->
        <activity
            android:name=".BookCoverScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CloudAccountActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".UserModeSelectionActivity"
            android:exported="false" />

        <activity
            android:name=".BackupRestoreActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".BackupExportActivity"
            android:exported="false" />

        <activity
            android:name=".ParentDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".BookmarksActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".WeeklyStudyActivity"
            android:exported="false" />

        <activity
            android:name=".GlobalSearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".AllChapterNotesActivity"
            android:exported="false" />

        <activity
            android:name=".ChapterNotesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ReminderSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".SmartStudyPlanActivity"
            android:exported="false" />

        <activity
            android:name=".DoubtHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".AskStudySaathiActivity"
            android:exported="false" />

        <activity
            android:name=".LearningProgressActivity"
            android:exported="false" />

        <activity
            android:name=".PracticeActivity"
            android:exported="false" />

        <activity
            android:name=".RevisionActivity"
            android:exported="false" />

        <activity
            android:name=".LessonActivity"
            android:exported="false" />

        <activity
            android:name=".ChaptersActivity"
            android:exported="false" />

        <activity
            android:name=".SubjectsActivity"
            android:exported="false" />

        <activity
            android:name=".StudentProfilesActivity"
            android:exported="false" />

        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <activity
            android:name=".StudentProfileActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

        <!-- Parent editor and approval screen for exact chapter learning content. -->
        <activity
            android:name=".SchoolBookChapterContentEditorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Parent review and approval screen for page-wise scanned chapter drafts. -->
        <activity
            android:name=".SchoolBookChapterPageReviewActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Child Mode one-page-at-a-time Kinder chapter reader. -->
        <activity
            android:name=".ChapterPageReaderActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>
